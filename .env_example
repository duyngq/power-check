# ===========================================
# Cấu hình cho script lấy lịch cúp điện
# ===========================================

# Link lấy lịch cúp điện (có thể thay đổi theo tỉnh/thành phố)
POWER_OUTAGE_URL=https://lichcupdien.org/lich-cup-dien-lam-dong

# Khu vực cần filter/highlight (phân cách bằng dấu phẩy nếu nhiều khu vực)
HIGHLIGHT_AREAS=Xuân Trường

# Tên tỉnh/thành phố (hiển thị trong tiêu đề)
PROVINCE_NAME=Lâm Đồng

# File output HTML
OUTPUT_HTML_FILE=lich_cup_dien.html

# ===========================================
# Cấu hình Table Columns (JSON format)
# ===========================================
TABLE_COLUMNS=[{"key": "_index", "label": "#", "width": 4, "align": "center", "style": "cyan"}, {"key": "dien_luc", "label": "Điện Lực", "width": 25, "align": "left", "style": "green"}, {"key": "ngay", "label": "Ngày", "width": 20, "align": "center", "style": "yellow"}, {"key": "thoi_gian", "label": "Thời gian", "width": 15, "align": "center", "style": "blue"}, {"key": "khu_vuc", "label": "Khu Vực", "width": 40, "align": "left", "style": "white"}, {"key": "ly_do", "label": "Lý Do", "width": 30, "align": "left", "style": "white"}, {"key": "trang_thai", "label": "Trạng Thái", "width": 12, "align": "center", "style": "green"}]

# ===========================================
# Cấu hình Telegram
# ===========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_IDS=your_chat_id_here
